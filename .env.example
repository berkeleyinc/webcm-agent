# Copy to .env (git-ignored) and adjust. docker compose reads .env automatically.
#
# The agent's brain: any OpenAI-compatible /chat/completions endpoint.
LLM_BASE_URL=http://127.0.0.1:4000/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Dealigned
# Context window in tokens (used to trim the transcript) and per-reply cap.
LLM_CONTEXT_WINDOW=1048576
LLM_MAX_TOKENS=4096

# Host port for the web UI.
WEB_PORT=8095

# Per-session limits. See server/src/config.js for the full set.
SESSION_MAX_RUNNING=8
SESSION_MAX_WALL_MS=1800000
SESSION_IDLE_MS=900000
SESSION_DETACH_MS=60000
SESSION_MEMORY_MIB=1536

LOG_LEVEL=info
